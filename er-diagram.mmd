erDiagram

    departments {
        int id PK
        string name
        string created_at
    }

    users {
        int id PK
        string employee_id
        string name
        string email
        string password_hash
        string role
        int department_id FK
        string designation
        string phone
        int is_active
        string created_at
        string updated_at
    }

    assets {
        int id PK
        string asset_id
        string asset_type
        string serial_number
        string description
        string status
        int department_id FK
        string issued_date
        string end_of_life_date
        int created_by FK
        string created_at
        string updated_at
    }

    requests {
        int id PK
        string request_number
        int requested_by FK
        int department_id FK
        string request_type
        string asset_type
        int quantity
        string justification
        string status
        int service_asset_id FK
        string service_reason
        string requester_name
        string requester_employee_id
        string requester_email
        string requester_designation
        string requester_phone
        int tentative_asset_id FK
        string im_notes
        int allocated_asset_id FK
        string allocation_date
        string assigned_to_name
        string condition_on_issue
        int acknowledged
        string created_at
        string updated_at
    }

    approvals {
        int id PK
        int request_id FK
        string step
        string status
        int reviewer_id FK
        string comments
        string reviewed_at
        string created_at
    }

    departments ||--o{ users : "has"
    departments ||--o{ assets : "holds"
    users ||--o{ assets : "creates"
    users ||--o{ requests : "submits"
    users ||--o{ approvals : "reviews"
    requests ||--o{ approvals : "has"
    assets ||--o{ requests : "tentative_asset"
    assets ||--o| requests : "allocated_asset"
    assets ||--o{ requests : "service_asset"
